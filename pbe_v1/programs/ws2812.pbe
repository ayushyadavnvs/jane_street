; WS2812 / NeoPixel LED driver (800 kbit/s, one data line).
; Config: tick = 2 clocks (CLKDIV = 1 at 60 MHz, 33.3 ns), OUT MSB first, data = pin base.
; Host protocol: queue 3 bytes per LED in the order the LEDs expect (G, R, B), as fast as the
; FIFO accepts them. When the FIFO runs dry the line stays low; after 50 us the LEDs latch.
; The host must stream about 100 kB/s, so its SPI port should run near clk / 8.
;
; Bit timing (spec +/-150 ns): 0 = 0.40 us high + 0.83 us low; 1 = 0.80 us high + 0.43 us low
; (37 ticks, 1.23 us a bit). At a byte boundary the low phase is 3 ticks (100 ns) longer:
; 0.93 / 0.53 us, still in spec. (At 48 MHz the delays were [9], [9], [8]: D92.)
.equ d 0

        PIN  d, DRV0
next:   PULL                 ; waits with the line low: a long wait latches the LEDs
        SET  X, 7
bit:    PIN  d, DRV1 [11]    ; t = 0:     high
        PIN  d, OUT [11]     ; t = 0.40:  a 1 stays high, a 0 goes low
        PIN  d, DRV0 [11]    ; t = 0.80:  low
        JMP  X--, bit        ; t = 1.20:  next bit at 1.23 us
        JMP  next

; I2C controller: START, repeated START, STOP, ACK/NACK, clock stretching.
; Config: OUT and IN MSB first; sda = pin base + 0, scl = pin base + 1 (both need pull-ups).
; Tick = 1/7 of the SCL period.
;
; Host protocol
;   Each I2C byte is 2 TX bytes: [data] [ack]
;     write: data = byte to send,  ack = 0x80 (release SDA so the peripheral can ACK)
;     read:  data = 0xFF,          ack = 0x00 to ACK, 0x80 to NACK the last byte
;   Each I2C byte returns 2 RX bytes: [byte seen on SDA] [ACK bit, 0 = ACK, 1 = NACK]
;   Set FLAG0 for a START (or repeated START) before the next byte,
;   set FLAG1 for a STOP. Set either only while the TX FIFO is empty.
.equ sda 0
.equ scl 1

idle:   JMP  TX_READY, have
        JMP  FLAG1, stop
        JMP  idle            ; SCL stays low between bytes, which I2C allows
have:   JMP  FLAG0, start
byte:   PULL
        SET  X, 7
bit:    PIN  sda, OUTOD      ; change SDA only while SCL is low
        PIN  scl, REL
        WAIT scl, HIGH       ; clock stretching: wait while the peripheral holds SCL low
        IN   sda [1]         ; sample in the middle of SCL high
        PIN  scl, DRV0
        JMP  X--, bit
        PUSH                 ; the byte seen on the bus
        PULL                 ; ACK slot
        PIN  sda, OUTOD
        PIN  scl, REL
        WAIT scl, HIGH
        IN   sda [1]
        PIN  scl, DRV0
        PUSH                 ; 0 = ACK, 1 = NACK
        JMP  idle
start:  FLAG 0, CLR
        PIN  sda, REL        ; for a repeated START, SCL is low here
        PIN  scl, REL
        WAIT scl, HIGH [1]
        PIN  sda, DRV0 [1]   ; START: SDA falls while SCL is high
        PIN  scl, DRV0
        JMP  byte
stop:   FLAG 1, CLR
        PIN  sda, DRV0
        PIN  scl, REL
        WAIT scl, HIGH [1]
        PIN  sda, REL [3]    ; STOP: SDA rises while SCL is high
        JMP  idle

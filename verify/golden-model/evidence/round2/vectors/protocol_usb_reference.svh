// Generated by pinned external packet libraries; do not edit.
logic [7:0] usb_ref_expected[$];
task automatic usb_ref_bytes(input int index);
  case(index)
    0: h_pkt = '{8'h2d, 8'h00, 8'h10}; // setup
    1: h_pkt = '{8'h69, 8'h00, 8'h10}; // in
    2: h_pkt = '{8'he1, 8'h00, 8'h10}; // out
    3: h_pkt = '{8'h69, 8'h25, 8'h58}; // wrong_address
    4: h_pkt = '{8'h69, 8'h00, 8'h90}; // bad_crc5
    5: h_pkt = '{8'hd2}; // ack
    6: h_pkt = '{8'h5a}; // nak
    7: h_pkt = '{8'h1e}; // stall
    8: h_pkt = '{8'hc3, 8'h80, 8'h06, 8'h00, 8'h01, 8'h00, 8'h00, 8'h12, 8'h00, 8'he0, 8'hf4}; // get_descriptor
    9: h_pkt = '{8'hc3, 8'h40, 8'h01, 8'h00, 8'h00, 8'h00, 8'h00, 8'h07, 8'h00, 8'ha9, 8'h34}; // vendor_write
    10: h_pkt = '{8'hc3, 8'hc0, 8'h02, 8'h00, 8'h00, 8'h00, 8'h00, 8'h08, 8'h00, 8'h97, 8'ha4}; // vendor_read
    11: h_pkt = '{8'hc3, 8'h80, 8'h06, 8'h02, 8'h03, 8'h09, 8'h04, 8'h40, 8'h00, 8'he7, 8'heb}; // unsupported
    12: h_pkt = '{8'hc3, 8'h80, 8'h06, 8'h00, 8'h01, 8'h00, 8'h00, 8'h12, 8'h00, 8'he0, 8'h74}; // bad_crc16
    13: h_pkt = '{8'h4b, 8'h12, 8'h01, 8'h10, 8'h01, 8'hff, 8'h00, 8'h00, 8'h08, 8'h21, 8'h63}; // descriptor0
    14: h_pkt = '{8'hc3, 8'h34, 8'h12, 8'h78, 8'h56, 8'h00, 8'h01, 8'h00, 8'h00, 8'h9c, 8'ha6}; // descriptor1
    15: h_pkt = '{8'h4b, 8'h00, 8'h01, 8'h3f, 8'h8f}; // descriptor2
    16: h_pkt = '{8'h4b, 8'h00, 8'h00}; // empty_data1
    17: h_pkt = '{8'h4b, 8'hff, 8'hff, 8'h02, 8'h4b, 8'h32, 8'h67, 8'ha6, 8'h9a, 8'h5e}; // vendor_payload
    18: h_pkt = '{8'h4b, 8'ha6, 8'h67, 8'h32, 8'h4b, 8'h02, 8'hff, 8'hff, 8'h55, 8'h33, 8'h3b}; // vendor_reply
    default: $fatal(1,"unknown independent USB packet");
  endcase
endtask
task automatic usb_ref_send(input int index);
  usb_ref_bytes(index);
  $write("REF_USB_SENT %0d ",index); foreach(h_pkt[i]) $write("%02x",h_pkt[i]); $display("");
  hs_send;
endtask
task automatic usb_ref_expect(input int index);
  usb_ref_bytes(index); usb_ref_expected = h_pkt;
  check(r_ok, "independent USB expected device response");
  check(r_pkt.size() == usb_ref_expected.size(), $sformatf("independent USB response size %0d expected %0d",r_pkt.size(),usb_ref_expected.size()));
  foreach(usb_ref_expected[i]) if(i < r_pkt.size())
    check(r_pkt[i] === usb_ref_expected[i], $sformatf("independent USB response byte %0d got %02x expected %02x",i,r_pkt[i],usb_ref_expected[i]));
  $write("REF_USB_RESPONSE %0d ",index); foreach(r_pkt[i]) $write("%02x",r_pkt[i]); $display("");
endtask
task automatic usb_ref_in(input int expected);
  int tries;
  tries=0;
  do begin usb_ref_send(1); hs_recv; tries++;
    if(r_ok && r_pkt.size()==1 && r_pkt[0]==8'h5a) repeat(400) @(posedge clk);
  end while(r_ok && r_pkt.size()==1 && r_pkt[0]==8'h5a && tries<200);
  usb_ref_expect(expected);
endtask
task automatic usb_reference;
  $display("Independent USB packet-library pin tests");
  h_pct=0;
  usb_ref_send(3);
  hs_recv; check(!r_ok,"independent USB invalid/address token was answered"); gap;
  usb_ref_send(4);
  hs_recv; check(!r_ok,"independent USB invalid/address token was answered"); gap;
  usb_ref_send(0);
  usb_ref_send(12);
  hs_recv; check(!r_ok,"independent USB bad CRC16 was ACKed"); gap;
  repeat(5000) @(posedge clk);
  usb_ref_send(0);
  usb_ref_send(8);
  hs_recv; usb_ref_expect(5); gap;
  usb_ref_in(13);
  usb_ref_send(5);
  gap;
  usb_ref_in(14);
  usb_ref_send(5);
  gap;
  usb_ref_in(15);
  usb_ref_send(5);
  gap;
  usb_ref_send(2);
  usb_ref_send(16);
  hs_recv; usb_ref_expect(5); gap;
  usb_ref_send(0);
  usb_ref_send(9);
  hs_recv; usb_ref_expect(5); gap;
  usb_ref_send(2);
  usb_ref_send(17);
  hs_recv; usb_ref_expect(5); gap;
  usb_ref_in(16);
  usb_ref_send(5);
  gap;
  usb_ref_send(0);
  usb_ref_send(10);
  hs_recv; usb_ref_expect(5); gap;
  usb_ref_in(18);
  usb_ref_send(5);
  gap;
  usb_ref_send(2);
  usb_ref_send(16);
  hs_recv; usb_ref_expect(5); gap;
  usb_ref_send(0);
  usb_ref_send(11);
  hs_recv; usb_ref_expect(5); gap;
  usb_ref_in(7);
  gap;
  repeat(6000) @(posedge clk); fw_run=0;
  check(contention==0,"independent USB bus contention");
  check(r_bad==0,"independent USB response stuffing errors");
  check(fw_bad==1,"independent USB corrupt DATA record count");
  check(tt_min>=2.0 && tt_max<=7.5,"independent USB turnaround outside USB bounds");
  if(errors) $fatal(1,"independent USB vectors failed: %0d",errors);
  $display("REFERENCE_USB_PASS packets=%0d turnaround=%0.3f..%0.3f",19,tt_min,tt_max);
endtask

; Low-speed USB packet transmitter.
; Config: D+ = pin base, D- = pin base + 1, BITDIV = clocks per bit - 1, CLKDIV = 0, OUT LSB first.
; Host: queue the whole packet [PID] [data...] in the TX FIFO (up to 16 bytes), then set
;   FLAG0 to send it, plus FLAG1 to append a CRC16 (DATA packets). Handshakes: PID only, FLAG0.
; The engine clears both flags once the EOP is on the wire.
idle:   JMP  FLAG0, go
        JMP  idle
go:     SET  OSR, 0x80       ; SYNC: 0000 0001, NRZI gives KJKJKJKK
        SET  X, 7
sync:   UTX  NOCRC
        JMP  X--, sync
        PULL                 ; PID, not covered by the CRC
        SET  X, 7
pid:    UTX  NOCRC
        JMP  X--, pid
        CRC
data:   JMP  TX_EMPTY, tail
        PULL
        SET  X, 7
dbit:   UTX
        JMP  X--, dbit
        JMP  data
tail:   JMP  FLAG1, crc
eop:    UEOP
        UIDLE                ; wait until SE0, SE0, J has been sent
        FLAG 0, CLR
        FLAG 1, CLR
        JMP  idle
crc:    OSRCRC LO
        SET  X, 7
c0:     UTX  NOCRC
        JMP  X--, c0
        OSRCRC HI
        SET  X, 7
c1:     UTX  NOCRC
        JMP  X--, c1
        JMP  eop

; Modbus RTU master over RS-485, half duplex, any baud rate.
; Uses the engine's CRC unit, parity bit and timeout.
;
; Config: tick = 1/8 bit (CLKDIV = clk / (8 * baud) - 1), OUT and IN LSB first, JMP_PIN = rx.
;   CRC_POLY = 0x8005, CRC_CFG = 0xFF (16 bits, init all ones, reversed output, fed by OUT and IN)
;   LINE_CFG = 1 (timeout jumps to word 1; even parity) or 0x81 for odd parity
;   TIMEOUT  = 1.5 characters in ticks, + 9: 141 (any baud rate). After 1.5 characters of
;              silence the program watches the line 2 more characters: silence ends the frame
;              (3.5 characters in all), a start bit makes it invalid (BUG-039).
; Pins: tx = pin base, rx = pin base + 1, de = pin base + 2 (RS-485 driver enable).
;
; Host protocol
;   Send: queue the request's data bytes (no CRC). When everything is queued and the TX FIFO is
;     empty, set FLAG1. The engine appends the CRC, turns the driver off after the last stop
;     bit and clears FLAG1.
;   Receive: each character arrives as [data] [status]: status bit 0 = parity error, bit 1 = CRC
;     ok so far (so on the last character: the frame's CRC is correct). At the end of the frame
;     the engine sets FLAG2 and raises IRQ.
;   Invalid frame: a character after more than 1.5 characters of silence inside a frame (Modbus
;     over serial line 2.5.1.1). The engine sets FLAG3 at once and stops receiving; once the line
;     has been silent for 3.5 characters it sets FLAG2 and raises IRQ as for any frame end. With
;     FLAG3 set the host discards the frame (the characters before the pause are in the RX FIFO,
;     none after it) and clears FLAG3.
;   FLAG0 is used inside the program ("in a frame").
.equ tx 0
.equ rx 1
.equ de 2

        JMP  init
tmo:    JMP  FLAG0, gap      ; word 1: a timeout lands here. In a frame: frame complete?
        JMP  TX_EMPTY, idle  ; idle: anything to send?
tx:     PIN  de, DRV1 [7]    ; driver on, one bit before the first start bit
        CRCRST
txc:    PULL                 ; data (also restarts the send parity)
        PIN  tx, DRV0 [6]    ; start bit
        SET  X, 6
tbit:   PIN  tx, OUT [6]     ; data bits 0..6, into the CRC
        JMP  X--, tbit
        PIN  tx, OUT [7]     ; data bit 7
        PIN  tx, OUTPAR [7]  ; parity bit
        PIN  tx, DRV1 [6]    ; stop bit
txw:    JMP  TX_READY, txc
        JMP  FLAG1, txcrc    ; request complete: append the CRC
        JMP  txw
txcrc:  OSRCRC LO            ; CRC low byte first
        PIN  tx, DRV0 [6]
        SET  X, 6
c0:     PIN  tx, OUT, NOCRC [6]
        JMP  X--, c0
        PIN  tx, OUT, NOCRC [7]
        PIN  tx, OUTPAR [7]
        PIN  tx, DRV1 [6]
        OSRCRC HI
        PIN  tx, DRV0 [6]
        SET  X, 6
c1:     PIN  tx, OUT, NOCRC [6]
        JMP  X--, c1
        PIN  tx, OUT, NOCRC [7]
        PIN  tx, OUTPAR [7]
        PIN  tx, DRV1 [7]    ; last stop bit, full length
        PIN  de, DRV0        ; driver off
        FLAG 1, CLR
        JMP  idle
gap:    SET  X, 87           ; 1.5 characters of silence so far: watch 2 more (88 x 2 ticks)
gw:     JMP  PIN_LO, bad     ; a start bit: the frame is invalid
        JMP  X--, gw
fend:   FLAG 0, CLR
        FLAG 2, SET          ; frame complete
        FLAG 0, IRQ
init:   PIN  tx, DRV1        ; line idles at mark (1)
        PIN  de, DRV0        ; driver off: listen
idle:   WAIT rx, FALL [3]    ; start bit of a new frame (or a timeout -> tmo); then 1/2 bit
        JMP  PIN_HI, idle    ; line high again: a glitch
        SET  X, 6
        FLAG 0, SET          ; in a frame
        CRCRST [4]           ; first data bit 1.5 bits after the start edge
rbit:   IN   rx [6]          ; data bits 0..6
        JMP  X--, rbit
        IN   rx              ; data bit 7
        PUSH [6]
        IN   rx, NOCRC       ; parity bit: into the parity check, not the CRC
        STAT                 ; ISR <= {.., CRC ok, parity error}
        PUSH
inframe: WAIT rx, FALL [3]   ; next character (or 1.5 characters of silence -> tmo)
        JMP  PIN_HI, inframe
        SET  X, 6 [5]
        JMP  rbit
bad:    FLAG 3, SET          ; invalid frame: tell the host, receive nothing more
        SET  X, 153          ; until 3.5 characters of silence (154 x 2 ticks), then fend
        JMP  gw

; 1-Wire controller (standard speed).
; Config: tick = 1 us (CLKDIV = clk_MHz - 1), OUT and IN LSB first, dq = pin base (needs a pull-up).
;
; Host protocol
;   Reset/presence: with the TX FIFO empty, set FLAG0. The engine pulls DQ low 480 us, then
;     pushes 0x00 if a device answered with a presence pulse, 0x80 if not, and clears FLAG0.
;   Bytes: each TX byte is sent as 8 slots, LSB first; the byte seen on DQ comes back.
;     To read a byte, send 0xFF (a write-1 slot and a read slot are the same on the wire).
;   Single slots (Search ROM): set FLAG1 while the TX FIFO is empty. Each TX byte is then one
;     slot using bit 0; the bit seen comes back in bit 7 (0x80 or 0x00).
;   Strong pull-up (parasite-powered devices, e.g. DS18B20 CONVERT T): queue the byte first,
;     then set FLAG0. 7 us after the byte's last slot the engine drives DQ hard high, until the
;     host clears FLAG0. (FLAG0 with nothing queued still means reset.)
;
; Slot timing: low 6 us, release or keep low (write 0), sample at 13 us, release at 60 us,
; 5 us recovery: 65 us per slot.
.equ dq 0

idle:   JMP  TX_READY, byte  ; bytes first: FLAG0 with a byte queued means strong pull-up
        JMP  FLAG0, reset    ; FLAG0 with nothing queued: reset/presence
        JMP  idle
byte:   PULL
        JMP  FLAG1, one      ; single-slot mode
        SET  X, 7
bit:    PIN  dq, DRV0 [5]    ; t=0: every slot starts with 6 us low
        PIN  dq, OUTOD [6]   ; t=6: a 1 releases DQ, a 0 keeps it low
        IN   dq [15]         ; t=13: sample (devices answer before 15 us)
        NOP  [15]            ; t=29
        NOP  [14]            ; t=45
        PIN  dq, REL [3]     ; t=60: end of a write-0 pulse; recovery
        JMP  X--, bit        ; t=64: next slot starts at 65 us
        PUSH                 ; what was on the wire
        JMP  FLAG0, spu      ; FLAG0 set during this byte: strong pull-up
        JMP  idle
one:    SET  X, 0
        JMP  bit
reset:  PIN  dq, DRV0
        SET  X, 29
rlow:   JMP  X--, rlow [15]  ; 30 x 16 us: 480 us low
        PIN  dq, REL [15]
        NOP  [15]
        NOP  [15]
        NOP  [15]
        IN   dq              ; ~65 us after release: a present device holds DQ low
        SET  X, 25
rwait:  JMP  X--, rwait [15] ; rest of the presence window (> 480 us in total)
        PUSH                 ; 0x00 = device present, 0x80 = none
        FLAG 0, CLR          ; only now tell the host the reset is done
        JMP  idle
spu:    PIN  dq, DRV1        ; t=67: drive DQ hard high (within 10 us of the last slot)
        WAIT FLAG 0, LOW     ; until the host clears FLAG0
        PIN  dq, REL
        JMP  idle

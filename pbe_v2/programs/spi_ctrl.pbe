; SPI controller, mode 0 (CPOL 0, CPHA 0), full duplex.
; Config: tick = 1/4 SCLK period or slower, OUT and IN MSB first.
; Every byte the host queues is sent; the byte read back goes to the RX FIFO.
; CS_n stays low while the host keeps the TX FIFO fed.
.equ sclk 0
.equ mosi 1
.equ miso 2
.equ cs   3

        PIN  cs, DRV1
        PIN  sclk, DRV0
idle:   PULL                 ; wait for the first byte
        PIN  cs, DRV0        ; select the peripheral
next:   SET  X, 7
bit:    PIN  mosi, OUT       ; set data while SCLK is low
        PIN  sclk, DRV1      ; rising edge: both sides sample
        IN   miso
        PIN  sclk, DRV0      ; falling edge: both sides shift
        JMP  X--, bit
        PUSH
        JMP  TX_EMPTY, done
        PULL
        JMP  next
done:   PIN  cs, DRV1 [1]    ; deselect
        JMP  idle

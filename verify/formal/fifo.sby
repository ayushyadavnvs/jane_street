[tasks]
prove
cover
mark

[options]
prove: mode prove
prove: depth 32
mark: mode prove
mark: depth 32
cover: mode cover
cover: depth 64

[engines]
smtbmc yices

[script]
prove: read -formal -sv fifo_formal.sv
cover: read -formal -sv fifo_formal.sv
mark: read -formal -sv -D F_MARK fifo_formal.sv
chparam -set WIDTH 8 -set ADDR_BITS 4 pbe_fifo
prep -top pbe_fifo
async2sync
dffunmap

[files]
../../pbe_v1/build/formal/generated/fifo_formal.sv

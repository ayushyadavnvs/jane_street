; UART receiver, 8N1.
; Config: tick = 1/4 bit (CLKDIV = clk / (4 * baud) - 1), IN LSB first, JMP_PIN = rx.
; WAIT restarts the tick timer, so every sample below lands in the middle of a bit.
.equ rx 0

start:  WAIT rx, LOW [1]     ; start bit begins; next instruction is 1/2 bit later
        JMP  PIN_HI, start   ; line went high again: it was a glitch
        SET  X, 6 [2]        ; first data sample at 1.5 bits
bit:    IN   rx [2]          ; bits 0..6, one every 4 ticks
        JMP  X--, bit
        IN   rx              ; bit 7 at 8.5 bits
        PUSH                 ; byte to the host
        JMP  start           ; back to WAIT by 9.25 bits, inside the stop bit

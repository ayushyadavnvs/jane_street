; Modbus RTU over RS-485, half duplex, up to 19200 baud.
; Config: tick = 1/8 bit (CLKDIV = clk / (8 * baud) - 1), OUT and IN LSB first, JMP_PIN = rx.
; Pins: tx = pin base, rx = pin base + 1, de = pin base + 2 (RS-485 driver enable).
;
; Host protocol
;   Send: queue each character as two TX bytes, [data] [parity]. Bit 0 of the parity byte is
;     sent after the data: the even (or odd) parity bit, or 1 for 8N2 (a second stop bit).
;     The engine turns the driver on before the first character. When the whole request is
;     queued and the TX FIFO is empty, set FLAG1; the engine turns the driver off after the
;     last stop bit and then clears FLAG1.
;   Receive: each character arrives as two RX bytes, [data] [status]; status bit 7 is the
;     parity bit received, for the host to check. After 3.5 characters of silence the engine
;     sets FLAG2 (frame complete) and raises IRQ.
; The silence count below assumes 11-bit characters and a tick of 1/8 bit. Above 19200 baud
; Modbus specifies fixed 1.75 ms gaps, which no longer fit the 8-bit X counter.
.equ tx 0
.equ rx 1
.equ de 2
.equ silence 156             ; 3.5 characters, counted in 2-tick polls

        PIN  tx, DRV1        ; line idles at mark (1)
        PIN  de, DRV0        ; driver off: listen
idle:   JMP  PIN_LO, rxc     ; start bit of an incoming frame
        JMP  TX_EMPTY, idle
        PIN  de, DRV1 [7]    ; driver on, one bit before the first start bit
txc:    PULL                 ; data
        PIN  tx, DRV0 [6]    ; start bit, 8 ticks with the SET
        SET  X, 6
tbit:   PIN  tx, OUT [6]     ; data bits 0..6, 8 ticks each with the JMP
        JMP  X--, tbit
        PIN  tx, OUT [6]     ; data bit 7, 8 ticks with the PULL
        PULL                 ; parity byte
        PIN  tx, OUT [7]     ; parity bit (or second stop bit)
        PIN  tx, DRV1 [6]    ; stop bit
txw:    JMP  TX_READY, txc   ; next character
        JMP  FLAG1, txend    ; request complete
        JMP  txw
txend:  PIN  de, DRV0        ; driver off after the last stop bit
        FLAG 1, CLR
        JMP  idle
rxc:    SET  X, 6 [9]        ; first data bit 1.5 bits after the start edge
rbit:   IN   rx [6]          ; data bits 0..6
        JMP  X--, rbit
        IN   rx              ; data bit 7
        PUSH [6]
        IN   rx              ; parity bit, in bit 7 of the status byte
        PUSH
        SET  X, silence [4]  ; start polling in the stop bit, not the parity bit
gap:    JMP  PIN_LO, rxc     ; next character of the same frame
        JMP  X--, gap
        FLAG 2, SET          ; 3.5 characters of silence: frame complete
        FLAG 0, IRQ
        JMP  idle

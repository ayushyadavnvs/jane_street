; Waveform generator: bytes from the TX FIFO replayed onto 2 pins at a programmable rate, D86.
; Pins (relative to pin base): A = 0, B = 1, driven (push-pull). Both start low.
; Engine settings: SHIFT = 0x00 (OUT LSB first), CRC off, TIMEOUT 0, LINE_CFG 0x40.
;   CLKDIV >= 1: a new sample every 4 ticks, 4 (CLKDIV + 1) clocks: 6 MS/s at CLKDIV 1,
;   60 MHz / (4 (CLKDIV + 1)) in general. (At CLKDIV 0 every fourth sample is one clock longer:
;   4, 4, 4, 5 clocks.) Each OUT drives one pin, so B changes one tick after A in every sample.
;
; Host protocol.
;   TX FIFO: [n-1] [n bytes]   play n bytes (4n samples, n = 1..256). Sample k of a byte is
;            bits 2k (A) and 2k + 1 (B): bits 1..0 first, bits 7..6 last.
;   After the last sample the pins hold its level until the next record (the engine reads the
;   next record's first byte as the last sample ends, and waits there).
;   Nothing is returned in the RX FIFO.
; Rates: one byte per 16 (CLKDIV + 1) clocks. A record longer than the 16-byte FIFO needs the
;   host to write fast enough; the host port takes at most one byte per 8 SCK cycles at
;   SCK <= clk / 8 (64 clocks per byte with a burst write). Measured (tb_la, SCK = 6 MHz,
;   the first 15 bytes queued before the start): a sustained stream works at CLKDIV >= 3
;   (3 MS/s, one byte per 64 clocks, exactly the port's rate). If the FIFO runs empty the current sample is held (stretched)
;   until a byte arrives: the waveform pauses, it is not corrupted. Records of up to 16 bytes
;   (64 samples) can be queued whole and play at any rate.
.equ a 0
.equ b 1

        PIN  a, DRV0
        PIN  b, DRV0
        PULL                    ; n - 1
rec:    MOV  X, OSR
        PULL                    ; the first byte
loop:   PIN  a, OUT             ; sample 0: bits 0, 1
        PIN  b, OUT [2]
        PIN  a, OUT             ; sample 1: bits 2, 3
        PIN  b, OUT [2]
        PIN  a, OUT             ; sample 2: bits 4, 5
        PIN  b, OUT [2]
        PIN  a, OUT             ; sample 3: bits 6, 7
        PIN  b, OUT
        PULL                    ; the next byte (or, after the last, the next record's n - 1)
        JMP  X--, loop
        JMP  rec

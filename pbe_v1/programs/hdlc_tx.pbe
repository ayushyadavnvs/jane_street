; HDLC / SDLC transmitter, NRZ or NRZI, with 0x7E flags, zero-bit insertion and CRC-16/X.25,
; D88, D94.
; Pin (relative to pin base): TXD = 0, driven. The line coder sends the frames and inserts a 0
;   after five 1s; the flags are made around it (below).
; Engine settings: CLKDIV = bit time - 1 in clocks (>= 11: 5 Mbit/s at 60 MHz; 59 = 1 Mbit/s),
;   LINE = 0x09 (NRZ) or 0x0A (NRZI) (stuffing after 5 ones, bit transfers), SYNC = 0, LINE2 = 0,
;   SHIFT = 0x00 (LSB first), CRC_POLY = 0x1021, CRC_CFG = 0x7F (16 bits, init 0xFFFF,
;   reflected output, fed by OUT), LINE_CFG = 0x40, TIMEOUT 0.
; Flags (D94): each flag (0x7E) is sent between LINECTL STUFFOFF and STUFFON, inside the same
;   coder frame as the data, so the line level is continuous through it and NRZI works as well
;   as NRZ (LINE 0x0A instead of 0x09; nothing else changes). Back-to-back frames share a flag;
;   between frames the engine sends flags (interframe time fill, ISO/IEC 13239), so after the
;   first frame the coder never lets go of the line: letting go would hand it to the pin unit
;   at a level that in NRZI depends on the data, and the engine's own receiver would see it.
;   Before the first frame the line idles high (mark, the pin unit). (D88's version made each
;   flag from the coder's gap and the pin unit's high level, and idled with mark: NRZ only.)
; Host protocol: TX FIFO: [n-1] [n bytes] per frame (address, control, information; n = 1..256).
;   (A restart stops the flag fill and lets the line go.)
;   The engine adds the FCS (CRC-16/X.25: inverted, low byte first) and the flags. Frames
;   queued back to back share flags. A frame longer than the FIFO must be fed at least one byte
;   per 8 bit times: if the FIFO runs dry mid-frame the coder repeats the line level and STATUS
;   bit 4 (line error) is set: the frame is corrupt (the receiver's CRC will fail).
;   Nothing is returned.
.equ tx 0

        PIN  tx, DRV1           ; mark idle; the coder overrides it while it drives
idle:   PULL                    ; n - 1: a frame
        MOV  ISR, OSR           ; ISR: bytes left - 1
        LINECTL STUFFOFF        ; the opening flag
        SET  OSR, 0x7E
        SET  X, 7
of:     PIN  tx, OUT, NOCRC
        JMP  X--, of
        LINECTL STUFFON
frame:  CRCRST
byte:   PULL
        SET  X, 7
bit:    PIN  tx, OUT            ; data: stuffed by the coder, fed to the CRC
        JMP  X--, bit
        MOV  X, ISR
        JMP  X--, more
        OSRCRC LO, INV          ; FCS = the CRC inverted, low byte first
        SET  X, 7
f1:     PIN  tx, OUT, NOCRC
        JMP  X--, f1
        OSRCRC HI, INV
        SET  X, 7
f2:     PIN  tx, OUT, NOCRC
        JMP  X--, f2
        LINECTL STUFFOFF        ; the closing flag (the next frame's opening flag too)
        SET  OSR, 0x7E
        SET  X, 7
cf:     PIN  tx, OUT, NOCRC
        JMP  X--, cf
fill:   JMP  TX_READY, next     ; another frame: it shares this flag
        SET  OSR, 0x7E          ; none yet: another flag (interframe time fill), so the coder
        SET  X, 7               ;   never lets go of the line and its own receiver stays off
ff:     PIN  tx, OUT, NOCRC
        JMP  X--, ff
        JMP  fill
next:   LINECTL STUFFON
        PULL
        MOV  ISR, OSR
        JMP  frame
more:   MOV  ISR, X
        JMP  byte

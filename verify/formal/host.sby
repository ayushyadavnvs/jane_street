[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 24
cover: mode cover
cover: depth 224

[engines]
smtbmc yices

[script]
prove: read -formal -sv host_formal.sv
cover: read -formal -D FORMAL_COVER -sv host_formal.sv
read -formal -sv host_default.sv
prep -top host_default
async2sync
dffunmap

